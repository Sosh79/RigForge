<ui:FluentWindow x:Class="RigForge.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:RigForge.ViewModels"
                 xmlns:models="clr-namespace:RigForge.Models"
                 mc:Ignorable="d"
                 Title="RigForge" 
                 Height="860" 
                 Width="1260"
                 MinHeight="680"
                 MinWidth="920"
                 WindowStartupLocation="CenterScreen"
                 Icon="/Assets/app.ico"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">

    <Grid Background="{DynamicResource AppPageBackgroundBrush}" TextElement.Foreground="{DynamicResource AppTextPrimaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Modern Fluent TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     Title="RigForge - Bulk Installer &amp; Updater">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="/Assets/app_icon.png" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal" 
                            Margin="0,0,12,0" 
                            VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <ui:Button Command="{Binding ToggleThemeCommand}" 
                               Background="{DynamicResource AppControlBackgroundBrush}"
                               BorderBrush="{DynamicResource AppControlBorderBrush}"
                               BorderThickness="1"
                               Padding="10,4" 
                               ToolTip="Toggle Light / Dark Theme">
                        <TextBlock Text="🌓 Toggle Theme" 
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" />
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- Main Body -->
        <Grid Grid.Row="1" Margin="22,10,22,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Header & Hero Controls -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title & Summary Metrics -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="/Assets/app_icon.png" 
                               Width="34" Height="34" 
                               Margin="0,0,10,0" 
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <TextBlock Text="RigForge" 
                                   FontSize="23" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                   VerticalAlignment="Center" />
                        
                        <Border Background="#2563EB" CornerRadius="12" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PC Setup Engine" FontSize="11" FontWeight="Bold" Foreground="White" />
                        </Border>
                    </StackPanel>

                    <TextBlock Text="Effortlessly forge your PC setup with bulk silent installations and system updates." 
                               FontSize="13" 
                               Margin="0,5,0,8"
                               Foreground="{DynamicResource AppTextSecondaryBrush}" />

                    <!-- Quick Metrics Badges -->
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <Border Background="{DynamicResource AppBadgeBackgroundBrush}" 
                                BorderBrush="{DynamicResource AppControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8" 
                                Padding="10,4" 
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Total Catalog: " Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding AllPackages.Count}" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource AppBadgeBackgroundBrush}" 
                                BorderBrush="{DynamicResource AppControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8" 
                                Padding="10,4" 
                                Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Installed on PC: " Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding InstalledCount}" FontWeight="Bold" Foreground="#10B981" FontSize="12"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource AppBadgeBackgroundBrush}" 
                                BorderBrush="{DynamicResource AppControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8" 
                                Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Selected to Install: " Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" Foreground="#3B82F6" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Primary Action Buttons Deck -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <ui:Button Command="{Binding ScanInstalledCommand}"
                               Appearance="Secondary"
                               Margin="0,0,8,0"
                               Padding="12,8"
                               ToolTip="Scan your system to detect which apps are already installed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍 " FontSize="12" />
                            <TextBlock Text="Scan Installed" FontWeight="Medium" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </StackPanel>
                    </ui:Button>

                    <ui:Button x:Name="UpdateMenuBtn"
                               Appearance="Secondary"
                               Margin="0,0,8,0"
                               Padding="12,8"
                               Click="UpdateMenuBtn_Click"
                               ToolTip="Choose to update RigForge catalog apps or all PC apps">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🚀 " FontSize="12" />
                            <TextBlock Text="Update Apps" FontWeight="Medium" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            <TextBlock Text=" ▾" FontSize="11" Margin="4,0,0,0" Foreground="{DynamicResource AppTextSecondaryBrush}" />
                        </StackPanel>
                        <ui:Button.ContextMenu>
                            <ContextMenu Background="{DynamicResource AppCardBackgroundBrush}" 
                                         BorderBrush="{DynamicResource AppCardBorderBrush}"
                                         BorderThickness="1"
                                         Padding="4">
                                <MenuItem Header="Update RigForge Apps Only" 
                                          Command="{Binding UpgradeCatalogAppsCommand}"
                                          Padding="10,6"
                                          Foreground="{DynamicResource AppTextPrimaryBrush}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="⚡" FontSize="13" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Background="{DynamicResource AppCardBorderBrush}" Margin="4,3" />
                                <MenuItem Header="Update All PC Apps (Full System)" 
                                          Command="{Binding UpgradeAllCommand}"
                                          Padding="10,6"
                                          Foreground="{DynamicResource AppTextPrimaryBrush}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="🌐" FontSize="13" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>

                    <Button Command="{Binding InstallSelectedCommand}"
                            Padding="16,8"
                            Cursor="Hand"
                            ToolTip="Download and install all selected applications silently">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2563EB" />
                                <Setter Property="BorderBrush" Value="#1D4ED8" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="btnBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#1D4ED8" />
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="#1E40AF" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="#1E3A8A" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="btnBorder" Property="Background" Value="{DynamicResource AppDisabledButtonBackgroundBrush}" />
                                                    <Setter TargetName="btnBorder" Property="BorderBrush" Value="{DynamicResource AppDisabledButtonBorderBrush}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource AppDisabledButtonForegroundBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬇ " FontSize="13" FontWeight="Bold" />
                            <TextBlock Text="Install Selected" FontWeight="Bold" />
                            <Border CornerRadius="8" Padding="6,1" Margin="8,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1D4ED8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource AppDisabledBadgeBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource AppDisabledBadgeForegroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Filter, Presets & Search Toolbar -->
            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row 0: Quick Presets & Search Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Quick Presets: " 
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   VerticalAlignment="Center" 
                                   Margin="0,0,8,0" />

                        <ui:Button Command="{Binding ApplyPresetCommand}" 
                                   CommandParameter="essentials"
                                   Margin="0,0,6,0" 
                                   Padding="10,5" 
                                   Background="{DynamicResource AppControlBackgroundBrush}"
                                   BorderBrush="{DynamicResource AppControlBorderBrush}"
                                   BorderThickness="1"
                                   ToolTip="Select Chrome, 7-Zip, VLC, Discord, WinRAR">
                            <TextBlock Text="⭐ Essentials" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </ui:Button>

                        <ui:Button Command="{Binding ApplyPresetCommand}" 
                                   CommandParameter="developer"
                                   Margin="0,0,6,0" 
                                   Padding="10,5" 
                                   Background="{DynamicResource AppControlBackgroundBrush}"
                                   BorderBrush="{DynamicResource AppControlBorderBrush}"
                                   BorderThickness="1"
                                   ToolTip="Select VS Code, Git, Terminal, Node.js, Python, Docker, Everything">
                            <TextBlock Text="💻 Developer" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </ui:Button>

                        <ui:Button Command="{Binding ApplyPresetCommand}" 
                                   CommandParameter="gaming"
                                   Margin="0,0,6,0" 
                                   Padding="10,5" 
                                   Background="{DynamicResource AppControlBackgroundBrush}"
                                   BorderBrush="{DynamicResource AppControlBorderBrush}"
                                   BorderThickness="1"
                                   ToolTip="Select Steam, Epic Games, VC++ Runtimes, DirectX, Discord, Opera GX">
                            <TextBlock Text="🎮 Gaming" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </ui:Button>

                        <ui:Button Command="{Binding ApplyPresetCommand}" 
                                   CommandParameter="creator"
                                   Padding="10,5" 
                                   Background="{DynamicResource AppControlBackgroundBrush}"
                                   BorderBrush="{DynamicResource AppControlBorderBrush}"
                                   BorderThickness="1"
                                   ToolTip="Select OBS Studio, Blender, GIMP, Audacity, HandBrake, ShareX">
                            <TextBlock Text="🎨 Creator" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </ui:Button>
                    </StackPanel>

                    <!-- Search Box and Select/Clear Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Search apps by name, ID or description..."
                                    Width="280"
                                    Margin="0,0,10,0"
                                    ClearButtonEnabled="True" />

                        <ui:Button Command="{Binding SelectAllCommand}" 
                                   Margin="0,0,6,0" 
                                   Padding="10,5" 
                                   Appearance="Secondary"
                                   ToolTip="Select all apps currently visible">
                            <TextBlock Text="Select All" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </ui:Button>

                        <ui:Button Command="{Binding DeselectAllCommand}" 
                                   Padding="10,5" 
                                   Appearance="Secondary"
                                   ToolTip="Clear all selections">
                            <TextBlock Text="Clear" FontSize="12" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Horizontal Category Tabs -->
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ListBox ItemsSource="{Binding Categories}"
                             SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="14,6" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border"
                                                    Background="{DynamicResource AppControlBackgroundBrush}"
                                                    BorderBrush="{DynamicResource AppControlBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter x:Name="content"
                                                                  HorizontalAlignment="Center" 
                                                                  VerticalAlignment="Center" 
                                                                  TextElement.Foreground="{DynamicResource AppTextPrimaryBrush}" 
                                                                  TextElement.FontWeight="Medium" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#2563EB" />
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6" />
                                                    <Setter TargetName="content" Property="TextElement.Foreground" Value="#FFFFFF" />
                                                    <Setter TargetName="content" Property="TextElement.FontWeight" Value="Bold" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                        <Condition Property="IsSelected" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </ScrollViewer>
            </Grid>

            <!-- Applications Grid Cards View -->
            <ScrollViewer Grid.Row="2" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding FilteredPackages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:SoftwarePackage}">
                            <Border Margin="0,0,12,12" 
                                    Width="380" 
                                    Padding="14"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource AppCardBackgroundBrush}"
                                    BorderBrush="{DynamicResource AppCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Card Row: Checkbox, Logo, Name, Category -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Selection Checkbox -->
                                        <CheckBox Grid.Column="0" 
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                  VerticalAlignment="Center" 
                                                  Margin="0,0,10,0" />

                                        <!-- App Logo Thumbnail Container -->
                                        <Border Grid.Column="1" 
                                                Width="40" Height="40" 
                                                CornerRadius="8" 
                                                Background="{DynamicResource AppControlBackgroundBrush}"
                                                BorderBrush="{DynamicResource AppControlBorderBrush}"
                                                BorderThickness="1"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding IconPath}" 
                                                   Width="28" Height="28" 
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   VerticalAlignment="Center" 
                                                   HorizontalAlignment="Center" />
                                        </Border>

                                        <!-- App Name & ID -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" 
                                                       FontWeight="Bold" 
                                                       FontSize="14" 
                                                       TextTrimming="CharacterEllipsis" 
                                                       Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                            
                                            <TextBlock Text="{Binding Id}" 
                                                       FontSize="11" 
                                                       Foreground="{DynamicResource AppTextMutedBrush}" 
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!-- Category Tag Badge -->
                                        <Border Grid.Column="3" 
                                                Background="{DynamicResource AppControlBackgroundBrush}" 
                                                BorderBrush="{DynamicResource AppControlBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6" 
                                                Padding="7,2" 
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Category}" 
                                                       FontSize="10" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource AppTextSecondaryBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Middle Card Row: Description -->
                                    <TextBlock Grid.Row="1" 
                                               Text="{Binding Description}" 
                                               Margin="0,8,0,10" 
                                               FontSize="12" 
                                               Foreground="{DynamicResource AppTextSecondaryBrush}" 
                                               TextWrapping="Wrap" 
                                               MaxHeight="36" 
                                               TextTrimming="CharacterEllipsis" 
                                               ToolTip="{Binding Description}" />

                                    <!-- Bottom Card Row: Status Badge & Install Button -->
                                    <Grid Grid.Row="2" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Status Indicator Badge -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="9" Height="9" 
                                                     Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                                                     Margin="0,0,6,0" />
                                            
                                            <TextBlock Text="{Binding StatusMessage}" 
                                                       FontSize="11" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" 
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Quick Single Install Button -->
                                        <ui:Button Grid.Column="1" 
                                                   Padding="12,4" 
                                                   Background="{DynamicResource AppControlBackgroundBrush}"
                                                   BorderBrush="{DynamicResource AppControlBorderBrush}"
                                                   BorderThickness="1"
                                                   Command="{Binding DataContext.InstallSingleCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                   CommandParameter="{Binding}"
                                                   IsEnabled="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Converter={StaticResource InverseBooleanConverter}}">
                                            <TextBlock Text="Install" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                        </ui:Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Status Drawer & Console Log Viewer -->
        <Border Grid.Row="2" 
                Background="{DynamicResource AppCardBackgroundBrush}" 
                BorderBrush="{DynamicResource AppCardBorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status Bar with Progress and Controls -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Status Text -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <ui:ProgressRing Width="18" Height="18" 
                                         IsIndeterminate="True" 
                                         Margin="0,0,10,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding StatusMessage}" 
                                   FontWeight="SemiBold" 
                                   FontSize="13" 
                                   VerticalAlignment="Center" 
                                   Foreground="{DynamicResource AppTextPrimaryBrush}" />
                    </StackPanel>

                    <!-- Progress Bar (Visible when busy or progress > 0) -->
                    <ProgressBar Grid.Column="1" 
                                 Value="{Binding ProgressValue}" 
                                 IsIndeterminate="{Binding IsIndeterminate}" 
                                 Height="6" 
                                 Margin="0,0,16,0" 
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Action Controls (Cancel & Toggle Log) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Command="{Binding CancelCommand}" 
                                   Appearance="Danger" 
                                   Padding="10,4" 
                                   Margin="0,0,8,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Cancel" FontSize="11" FontWeight="Bold" />
                        </ui:Button>

                        <ui:Button Command="{Binding ToggleLogsCommand}" 
                                   Background="{DynamicResource AppControlBackgroundBrush}"
                                   BorderBrush="{DynamicResource AppControlBorderBrush}"
                                   BorderThickness="1"
                                   Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋 Live Terminal (" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text="{Binding Logs.Count}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                                <TextBlock Text=")" FontSize="11" Foreground="{DynamicResource AppTextPrimaryBrush}" />
                            </StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>

                <!-- Collapsible Live Log Console -->
                <Grid Grid.Row="1" 
                      Margin="0,10,0,0" 
                      Height="200"
                      Visibility="{Binding IsLogVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="#090D16" 
                            CornerRadius="8" 
                            BorderBrush="#1E293B" 
                            BorderThickness="1" 
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Log Header Controls -->
                            <Grid Grid.Row="0" Margin="4,2,4,6">
                                <TextBlock Text="Execution Logs (Standard Output &amp; Errors)" 
                                           Foreground="#94A3B8" 
                                           FontSize="11" 
                                           FontWeight="SemiBold" 
                                           VerticalAlignment="Center" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button Command="{Binding ClearLogsCommand}" 
                                               Padding="8,2" 
                                               Appearance="Secondary" 
                                               Margin="0,0,6,0">
                                        <TextBlock Text="Clear" FontSize="10" />
                                    </ui:Button>
                                    <ui:Button Command="{Binding ToggleLogsCommand}" 
                                               Padding="8,2" 
                                               Appearance="Secondary">
                                        <TextBlock Text="Hide" FontSize="10" />
                                    </ui:Button>
                                </StackPanel>
                            </Grid>

                            <!-- Live Log Stream List -->
                            <ListBox Grid.Row="1" 
                                     ItemsSource="{Binding Logs}" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas, Cascadia Code, Courier New" 
                                     FontSize="11">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:InstallLogEntry}">
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="[" Foreground="#64748B" />
                                            <TextBlock Text="{Binding FormattedTime}" Foreground="#94A3B8" />
                                            <TextBlock Text="] " Foreground="#64748B" />
                                            <TextBlock Text="{Binding Message}" 
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToBrushConverter}}" 
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
